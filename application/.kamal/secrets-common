# Kamal reads this file for every destination. Keep only indirections here.
# Never commit raw credentials.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Restricted credentials used by long-running application containers.
DATABASE_URL=$DATABASE_URL
CACHE_DATABASE_URL=$CACHE_DATABASE_URL
QUEUE_DATABASE_URL=$QUEUE_DATABASE_URL
CABLE_DATABASE_URL=$CABLE_DATABASE_URL

# Owner credentials are operator-only. They are intentionally not referenced by
# config/deploy.yml and are never injected into long-running application roles.
DATABASE_MIGRATION_URL=$DATABASE_MIGRATION_URL
CACHE_DATABASE_MIGRATION_URL=$CACHE_DATABASE_MIGRATION_URL
QUEUE_DATABASE_MIGRATION_URL=$QUEUE_DATABASE_MIGRATION_URL
CABLE_DATABASE_MIGRATION_URL=$CABLE_DATABASE_MIGRATION_URL
POSTGRES_RUNTIME_PASSWORD=$POSTGRES_RUNTIME_PASSWORD

LMX_PHASE0_WORKSPACE_ID=$LMX_PHASE0_WORKSPACE_ID
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=$TELEGRAM_CHAT_ID
OTEL_EXPORTER_OTLP_ENDPOINT=$OTEL_EXPORTER_OTLP_ENDPOINT
OTEL_EXPORTER_OTLP_HEADERS=$OTEL_EXPORTER_OTLP_HEADERS
