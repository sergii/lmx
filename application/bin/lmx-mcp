#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["RAILS_LOG_TO_STDOUT"] = nil

require_relative "../config/environment"

server = Integration::McpRuntime.build
Integration::Mcp::StdioTransport.new(server:).open
rescue ArgumentError, KeyError => error
  warn("LMX MCP configuration error: #{error.message}")
  exit(1)
