#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system! "npm install"

  puts "\n== Preparing database =="
  migration_environment = { "POSTGRES_USER" => ENV.fetch("POSTGRES_MIGRATION_USER", "lmx") }
  runtime_environment = migration_environment.merge(
    "POSTGRES_RUNTIME_PASSWORD" => ENV.fetch("POSTGRES_RUNTIME_PASSWORD", ENV.fetch("POSTGRES_PASSWORD", "lmx_development"))
  )

  if ARGV.include?("--reset")
    system! "bin/reset-database"
  else
    system! migration_environment, "bin/rails db:prepare"
    system! migration_environment, "bin/rails db:seed"
    system! runtime_environment, "bin/rails db:provision_runtime_role"
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
