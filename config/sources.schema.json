{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmx.local/schema/sources.schema.json",
  "title": "LMX source registry",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "tier", "kind", "priority", "transports"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "base_url": { "type": ["string", "null"], "format": "uri" },
          "enabled": { "type": "boolean" },
          "tier": { "enum": ["A", "B", "C"] },
          "market": { "type": "string" },
          "kind": { "type": "string" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "resolve_original_posting": { "type": "boolean" },
          "specialties": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "transports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "preference", "status"],
              "properties": {
                "type": {
                  "enum": ["rss", "http_api", "http_scrape", "browser_crawl", "webhook", "api_submission", "manual", "import"]
                },
                "preference": { "type": "string" },
                "status": { "enum": ["evaluate", "planned", "active", "disabled"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "manual_ingestion": { "type": "object" },
    "transport_types": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
