# Copy to backend.hcl and replace every placeholder.
# Keep access credentials outside this file and pass them through
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or equivalent environment variables.

bucket       = "REPLACE_ME"
key          = "lmx/staging/terraform.tfstate"
region       = "REPLACE_ME"
use_lockfile = true

# For S3-compatible storage, also configure the endpoint and compatibility
# flags below. Remove this block when using AWS S3 directly.
