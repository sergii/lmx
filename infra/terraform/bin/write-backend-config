#!/usr/bin/env bash
set -euo pipefail

output_path="${1:-backend.ci.hcl}"

: "${TF_STATE_BUCKET:?TF_STATE_BUCKET is required}"
: "${TF_STATE_REGION:?TF_STATE_REGION is required}"

state_key="${TF_STATE_KEY:-lmx/staging/terraform.tfstate}"
s3_compatible="${TF_STATE_S3_COMPATIBLE:-false}"

mkdir -p "$(dirname "$output_path")"

cat > "$output_path" <<EOF
bucket       = "${TF_STATE_BUCKET}"
key          = "${state_key}"
region       = "${TF_STATE_REGION}"
use_lockfile = true
EOF

if [[ "$s3_compatible" == "true" ]]; then
  : "${TF_STATE_ENDPOINT:?TF_STATE_ENDPOINT is required when TF_STATE_S3_COMPATIBLE=true}"
  cat >> "$output_path" <<EOF

endpoints = {
  s3 = "${TF_STATE_ENDPOINT}"
}
use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
EOF
fi
